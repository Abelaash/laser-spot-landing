# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# Both variables are optional in development — the page runs without them.
# ---------------------------------------------------------------------------

# Google Tag Manager container ID. Leave empty to disable GTM entirely
# (useful locally, so you don't pollute your container with test traffic).
NEXT_PUBLIC_GTM_ID=

# Where the booking form POSTs its JSON payload.
# Anything that accepts a JSON POST works: Zapier / Make / n8n webhook,
# GoHighLevel inbound webhook, Formspree, or your own API route.
# Leave empty and the form still validates, still fires the dataLayer event,
# and still shows the success state — it just logs the payload instead.
NEXT_PUBLIC_FORM_ENDPOINT=
